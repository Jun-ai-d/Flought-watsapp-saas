# =============================================================================
# Flought Docker Compose / Coolify environment checklist
# Copy to .env for local `docker compose up --build` (never commit real secrets)
# =============================================================================

# --- Frontend (build-time — baked into Nginx image) ---
VITE_API_URL=https://api-staging.example.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_META_APP_ID=

# --- Backend (runtime — set in Coolify UI or .env for local Compose) ---
# Copy full list from backend/.env.example.
#
# Minimum to boot HTTP server + pass /health (API routes need these):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DB_ENCRYPTION_KEY=          # exactly 32 chars in production
# FRONTEND_URL=http://localhost:8080,https://app-staging.example.com
# PORT=4000
# NODE_ENV=production
#
# Required for background jobs (pg-boss); server still starts without it:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
#
# Required for AI features:
# OPENAI_API_KEY=
#
# Backend self-fetch quirk (tenant.ts):
# VITE_API_URL=https://api-staging.example.com

# --- Env matrix (ops reference) ---
# Variable              | Vercel (FE)     | Render (BE)   | Coolify FE      | Coolify BE
# VITE_API_URL            | Build env       | — (also BE*)  | Build arg       | Same as API URL*
# VITE_SUPABASE_URL       | Build env       | —             | Build arg       | —
# VITE_SUPABASE_ANON_KEY  | Build env       | —             | Build arg       | —
# VITE_META_APP_ID        | Build env       | —             | Build arg       | —
# SUPABASE_* / DATABASE_URL | —             | Dashboard     | —               | Coolify env
# FRONTEND_URL            | —               | Dashboard     | —               | Staging + prod origins
# PORT                    | —               | Render inject | —               | 4000
# * Backend tenant.ts self-fetch quirk — set VITE_API_URL on backend too
