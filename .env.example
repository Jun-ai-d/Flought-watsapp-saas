# =============================================================================
# Flought Docker Compose / Coolify environment checklist
# Copy to .env for local `docker compose up --build` (never commit real secrets)
# =============================================================================
#
# Local host ports (optional — root compose uses expose-only for Coolify VPS):
# Create docker-compose.override.yml next to docker-compose.yml:
#
#   services:
#     backend:
#       ports: ["4000:4000"]
#     frontend:
#       ports: ["8080:80"]
#
# Then: docker compose up --build → http://localhost:8080 (FE), :4000/health (BE)
# Coolify: assign Domains → backend port 4000, frontend port 80 (no host binds).

# --- Frontend (build-time — baked into Nginx image) ---
# Coolify: add these on the FRONTEND service only, toggle "Available at Buildtime", then REBUILD.
# URLs must include the scheme (https://). Restart without rebuild does NOT update VITE_* values.
VITE_API_URL=https://api-staging.your-domain.com
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key
VITE_META_APP_ID=

# --- Coolify frontend build args (same values as above) ---
# In Coolify UI → Frontend service → Environment:
#   VITE_SUPABASE_URL     = https://YOUR_PROJECT_REF.supabase.co
#   VITE_SUPABASE_ANON_KEY = eyJ... (Supabase → Settings → API → anon public)
#   VITE_API_URL          = https://YOUR_BACKEND_DOMAIN (Coolify domain for backend :4000)
#   VITE_META_APP_ID      = (optional)
# Each VITE_* var: enable "Available at Buildtime" → Save → Redeploy with rebuild.

# --- Backend Coolify minimum (runtime — set on BACKEND service in Coolify UI) ---
# Container passes /health once the process is listening.
# /health returns "degraded" until all required vars below are set.
#
# SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
# DB_ENCRYPTION_KEY=64-char-hex-from-openssl-rand-hex-32
#   OR exactly 32 UTF-8 characters
# FRONTEND_URL=https://your-coolify-frontend.example.com
# PORT=4000
# NODE_ENV=production
# VITE_API_URL=https://your-coolify-backend.example.com
#
# Optional at boot (background jobs disabled without):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
#
# Required for AI bot replies:
# OPENAI_API_KEY=sk-...
#
# See backend/.env.example for full variable list.

# --- Env matrix (ops reference) ---
# Variable              | Vercel (FE)     | Render (BE)   | Coolify FE      | Coolify BE
# VITE_API_URL            | Build env       | — (also BE*)  | Build arg       | Same as API URL*
# VITE_SUPABASE_URL       | Build env       | —             | Build arg       | —
# VITE_SUPABASE_ANON_KEY  | Build env       | —             | Build arg       | —
# VITE_META_APP_ID        | Build env       | —             | Build arg       | —
# SUPABASE_* / DATABASE_URL | —             | Dashboard     | —               | Coolify env
# FRONTEND_URL            | —               | Dashboard     | —               | Staging + prod origins
# PORT                    | —               | Render inject | —               | 4000
# * Backend tenant.ts self-fetch quirk — set VITE_API_URL on backend too
