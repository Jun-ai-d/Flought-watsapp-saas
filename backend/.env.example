# =============================================================================
# Flought Backend Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM / AI (Required) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o-mini

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Encryption (Required in production) ---
# Must be exactly 32 characters. Used for AES-256-GCM encryption of BSP tokens.
DB_ENCRYPTION_KEY=your-32-character-encryption-key

# --- Meta Cloud API (Required for WhatsApp via Meta) ---
META_ACCESS_TOKEN=your-meta-permanent-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_APP_SECRET=your-meta-app-secret
# This is the single global token you paste into Meta's webhook "Verify Token" field.
META_VERIFY_TOKEN=flought-meta-test

# --- Gupshup (Required for WhatsApp via Gupshup) ---
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-gupshup-app-name
GUPSHUP_VERIFY_TOKEN=your-gupshup-verify-token

# --- Razorpay (Required for billing) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Frontend URL (for CORS) ---
# Comma-separated if multiple origins needed
FRONTEND_URL=http://localhost:5173
