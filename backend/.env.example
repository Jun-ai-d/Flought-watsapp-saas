# =============================================================================
# Flought Backend Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Coolify minimum (required for API + healthy production deploy) ---
# Server listens and /health returns 200 even if these are missing (degraded),
# but API routes throw until all three are set correctly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Exactly 32 UTF-8 chars OR 64 hex chars (openssl rand -hex 32)
DB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Server ---
PORT=4000
NODE_ENV=production

# --- CORS (include your Coolify frontend URL) ---
FRONTEND_URL=http://localhost:8080,https://app-staging.example.com

# --- LLM / AI (Required for bot replies) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o-mini

# --- Postgres for pg-boss (Optional at boot — background jobs disabled without it) ---
# Use Supabase connection string (pooler or direct on long-lived Coolify)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Meta Cloud API (Required for WhatsApp via Meta) ---
META_ACCESS_TOKEN=your-meta-permanent-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=flought-meta-test

# --- Gupshup (Required for WhatsApp via Gupshup) ---
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-gupshup-app-name
GUPSHUP_VERIFY_TOKEN=your-gupshup-verify-token

# --- Razorpay (Required for billing) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Public API URL (backend self-fetch quirk in tenant.ts) ---
# Set to your Coolify backend public URL (no trailing slash)
VITE_API_URL=https://api-staging.example.com

# --- Optional TTS ---
# FFMPEG_PATH=/usr/bin/ffmpeg
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# ENABLE_RERANK=false
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=
